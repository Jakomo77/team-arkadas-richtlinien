# Copy this file to "local.properties" (which is git-ignored) and fill in your values.

# GitHub personal access token (classic) with "read:packages" scope,
# used to pull the mwdat-* artifacts from GitHub Packages.
# See: https://wearables.developer.meta.com/docs/develop/dat/build-integration-android
github_token=

# App credentials from the Meta Wearables Developer Center.
# Not required while "Entwicklungsmodus" (Developer Mode) is enabled in the
# Meta AI app on your phone - in that mode the SDK auto-registers your app.
mwdat_application_id=
mwdat_client_token=

# API key for the Claude vision call used by the "AI-Interaktion" feature
# (ask Claude what it sees in a photo captured from the glasses).
anthropic_api_key=
